//@version=5
indicator("Kirito", overlay=true, max_lines_count=500, max_labels_count=500)

// =========================================================================
// 1. SUPERTREND (Converted to v5)
// =========================================================================
st_Periods = input.int(title="ATR Period", defval=10, group="SuperTrend")
st_src = input.source(hl2, title="SuperTrend Source", group="SuperTrend")
st_Multiplier = input.float(title="ATR Multiplier", step=0.1, defval=3.0, group="SuperTrend")
st_changeATR = input.bool(title="Change ATR Calculation Method ?", defval=true, group="SuperTrend")
st_showsignals = input.bool(title="Show Buy/Sell Signals ?", defval=true, group="SuperTrend")
st_highlighting = input.bool(title="Highlighter On/Off ?", defval=true, group="SuperTrend")

st_atr2 = ta.sma(ta.tr, st_Periods)
st_atr = st_changeATR ? ta.atr(st_Periods) : st_atr2

float st_up = st_src - (st_Multiplier * st_atr)
float st_up1 = nz(st_up[1], st_up)
st_up := close[1] > st_up1 ? math.max(st_up, st_up1) : st_up

float st_dn = st_src + (st_Multiplier * st_atr)
float st_dn1 = nz(st_dn[1], st_dn)
st_dn := close[1] < st_dn1 ? math.min(st_dn, st_dn1) : st_dn

float st_trend = 1
st_trend := nz(st_trend[1], 1)
st_trend := st_trend == -1 and close > st_dn1 ? 1 : st_trend == 1 and close < st_up1 ? -1 : st_trend

st_upPlot = plot(st_trend == 1 ? st_up : na, title="Up Trend", style=plot.style_linebr, linewidth=2, color=color.green)
st_buySignal = st_trend == 1 and st_trend[1] == -1
plotshape(st_buySignal ? st_up : na, title="UpTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(st_buySignal and st_showsignals ? st_up : na, title="Buy", text="Buy", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.green, textcolor=color.white)

st_dnPlot = plot(st_trend == 1 ? na : st_dn, title="Down Trend", style=plot.style_linebr, linewidth=2, color=color.red)
st_sellSignal = st_trend == -1 and st_trend[1] == 1
plotshape(st_sellSignal ? st_dn : na, title="DownTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
plotshape(st_sellSignal and st_showsignals ? st_dn : na, title="Sell", text="Sell", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.red, textcolor=color.white)

st_mPlot = plot(ohlc4, title="", style=plot.style_circles, display=display.none)
st_longFillColor = st_highlighting ? (st_trend == 1 ? color.green : color.white) : color.white
st_shortFillColor = st_highlighting ? (st_trend == -1 ? color.red : color.white) : color.white
fill(st_mPlot, st_upPlot, title="UpTrend Highligter", color=st_longFillColor)
fill(st_mPlot, st_dnPlot, title="DownTrend Highligter", color=st_shortFillColor)

alertcondition(st_buySignal, title="SuperTrend Buy", message="SuperTrend Buy!")
alertcondition(st_sellSignal, title="SuperTrend Sell", message="SuperTrend Sell!")
st_changeCond = st_trend != st_trend[1]
alertcondition(st_changeCond, title="SuperTrend Direction Change", message="SuperTrend has changed direction!")


// =========================================================================
// 2. CENTRAL PIVOT RANGE - Sherwind (Converted to v5)
// =========================================================================
cpr1_daily_cpr = input.int(title="How many Daily CPR to show", defval=5, minval=0, group="Sherwind CPR")
cpr1_weekly_cpr = input.int(title="How many Weekly CPR to show", defval=0, minval=0, group="Sherwind CPR")
cpr1_monthly_cpr = input.int(title="How many Monthly CPR to show", defval=0, minval=0, group="Sherwind CPR")
cpr1_yearly_cpr = input.int(title="How many Yearly CPR to show", defval=0, minval=0, group="Sherwind CPR")
cpr1_daily_cpr_color = input.color(title="Daily CPR color", defval=color.rgb(0, 128, 0, 40), group="Sherwind CPR")
cpr1_weekly_cpr_color = input.color(title="Weekly CPR color", defval=color.rgb(255, 165, 0, 50), group="Sherwind CPR")
cpr1_monthly_cpr_color = input.color(title="Monthly CPR color", defval=color.rgb(255, 0, 255, 70), group="Sherwind CPR")
cpr1_yearly_cpr_color = input.color(title="Yearly CPR color", defval=color.rgb(255, 0, 0, 70), group="Sherwind CPR")

cpr1_new_bar(res) => ta.change(time(res)) != 0
cpr1_cpr() =>
    pivot = (high + low + close) / 3.0
    bc = (high + low) / 2.0
    tc = pivot - bc + pivot
    [pivot, bc, tc]
cpr1_cpr_levels() =>
    [pivot, bc, tc] = cpr1_cpr()
    md_level = pivot[1]
    hi_level = tc[1] >= bc[1] ? tc[1] : bc[1]
    lo_level = tc[1] >= bc[1] ? bc[1] : tc[1]
    [md_level, hi_level, lo_level]
cpr1_draw_line(line_level, res, level_color, show_count) =>
    var line _line = na
    var ary_line = array.new_line(show_count)
    if cpr1_new_bar(res)
        line.set_x2(_line, bar_index)
        line.set_extend(_line, extend.none)
        _line := line.new(bar_index, line_level, bar_index, line_level, extend=extend.right, color=level_color)
        array.push(ary_line, _line)
        line.delete(array.shift(ary_line))
    if not na(_line) and line.get_x2(_line) != bar_index
        line.set_x2(_line, bar_index)
cpr1_draw_cpr(md_level, hi_level, lo_level, res, level_color, show_count) =>
    cpr1_draw_line(hi_level, res, level_color, show_count)
    cpr1_draw_line(md_level, res, level_color, show_count)
    cpr1_draw_line(lo_level, res, level_color, show_count)

[cpr1_dpp, cpr1_dbc, cpr1_dtc] = request.security(syminfo.tickerid, 'D', cpr1_cpr_levels(), lookahead=barmerge.lookahead_on)
if timeframe.isintraday and cpr1_daily_cpr > 0
    cpr1_draw_cpr(cpr1_dpp, cpr1_dtc, cpr1_dbc, "D", cpr1_daily_cpr_color, cpr1_daily_cpr)

[cpr1_wpp, cpr1_wbc, cpr1_wtc] = request.security(syminfo.tickerid, 'W', cpr1_cpr_levels(), lookahead=barmerge.lookahead_on)
if (timeframe.isintraday or timeframe.isdaily) and cpr1_weekly_cpr > 0
    cpr1_draw_cpr(cpr1_wpp, cpr1_wtc, cpr1_wbc, "W", cpr1_weekly_cpr_color, cpr1_weekly_cpr)

[cpr1_mpp, cpr1_mbc, cpr1_mtc] = request.security(syminfo.tickerid, 'M', cpr1_cpr_levels(), lookahead=barmerge.lookahead_on)
if (timeframe.isintraday or timeframe.isdaily or timeframe.isweekly) and cpr1_monthly_cpr > 0
    cpr1_draw_cpr(cpr1_mpp, cpr1_mtc, cpr1_mbc, "M", cpr1_monthly_cpr_color, cpr1_monthly_cpr)

[cpr1_ypp, cpr1_ybc, cpr1_ytc] = request.security(syminfo.tickerid, '12M', cpr1_cpr_levels(), lookahead=barmerge.lookahead_on)
if cpr1_yearly_cpr > 0
    cpr1_draw_cpr(cpr1_ypp, cpr1_ytc, cpr1_ybc, "12M", cpr1_yearly_cpr_color, cpr1_yearly_cpr)


// =========================================================================
// 3. EMA RIBBON (Converted to v5)
// =========================================================================
ema_dropn(src, n) =>
    na(src[n]) ? na : src

ema_length1 = input.int(20, title="MA-1 period", minval=1, group="EMA Ribbon")
ema_length2 = input.int(25, title="MA-2 period", minval=1, group="EMA Ribbon")
ema_length3 = input.int(30, title="MA-3 period", minval=1, group="EMA Ribbon")
ema_length4 = input.int(35, title="MA-4 period", minval=1, group="EMA Ribbon")
ema_length5 = input.int(40, title="MA-5 period", minval=1, group="EMA Ribbon")
ema_length6 = input.int(45, title="MA-6 period", minval=1, group="EMA Ribbon")
ema_length7 = input.int(50, title="MA-7 period", minval=1, group="EMA Ribbon")
ema_length8 = input.int(55, title="MA-8 period", minval=1, group="EMA Ribbon")
ema_src = input.source(close, title="EMA Source", group="EMA Ribbon")
ema_dropCandles = input.int(1, minval=0, title="Drop first N candles", group="EMA Ribbon")

ema_price = ema_dropn(ema_src, ema_dropCandles)

plot(ta.ema(ema_price, ema_length1), title="MA-1", color=#f5eb5d, linewidth=2)
plot(ta.ema(ema_price, ema_length2), title="MA-2", color=#f5b771, linewidth=2)
plot(ta.ema(ema_price, ema_length3), title="MA-3", color=#f5b056, linewidth=2)
plot(ta.ema(ema_price, ema_length4), title="MA-4", color=#f57b4e, linewidth=2)
plot(ta.ema(ema_price, ema_length5), title="MA-5", color=#f56d58, linewidth=2)
plot(ta.ema(ema_price, ema_length6), title="MA-6", color=#f57d51, linewidth=2)
plot(ta.ema(ema_price, ema_length7), title="MA-7", color=#f55151, linewidth=2)
plot(ta.ema(ema_price, ema_length8), title="MA-8", color=#aa2707, linewidth=2)


